# ============ Database ============
DATABASE_URL=postgresql://user:password@localhost:5432/daycare

# ============ Server ============
PORT=4000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here_change_in_production
BACKEND_URL=http://localhost:4000

# ============ AI Configuration ============
# Choose one of: openai, anthropic, google, mock
AI_PROVIDER=openai

# ============ OpenAI Configuration ============
# Get API key from: https://platform.openai.com/api-keys
AI_API_KEY=sk-your-openai-api-key-here

# Optional: OpenAI specific settings
# OPENAI_MODEL=gpt-4-turbo
# OPENAI_MAX_TOKENS=1000

# ============ Anthropic Configuration (Alternative) ============
# Get API key from: https://console.anthropic.com
# AI_API_KEY=sk-ant-your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-opus-20240229

# ============ Google Gemini Configuration (Alternative) ============
# Get API key from: https://makersuite.google.com/app/apikey
# AI_API_KEY=your-google-gemini-api-key-here
# GOOGLE_MODEL=gemini-pro

# ============ Frontend URL (for CORS) ============
FRONTEND_URL=http://localhost:5173

# ============ Email Configuration (Optional) ============
# For sending reports via email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============ Logging ============
LOG_LEVEL=debug
